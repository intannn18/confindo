# ==============================================================================
# CONFindo Apache Configuration (cPanel / Web Hosting)
# ==============================================================================

<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType application/vnd.openxmlformats-officedocument.presentationml.presentation .pptx
  AddType application/zip .zip
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. Force HTTPS (Otomatis alihkan HTTP ke HTTPS yang aman)
  # ----------------------------------------------------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------
  # 2. Akses file atau folder yang memang ada secara langsung
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # 3. Clean URLs rewrites (URL cantik tanpa .html)
  # ----------------------------------------------------------------------
  RewriteRule ^learn/?$ learn/index.html [L]
  RewriteRule ^practice/?$ practice/index.html [L]
  RewriteRule ^tools/?$ tools/index.html [L]
  RewriteRule ^challenge/?$ challenge/index.html [L]
  RewriteRule ^store/?$ store/index.html [L]
  RewriteRule ^store/product/?$ store/product.html [L]
  RewriteRule ^store/viewer/?$ store/viewer.html [L]
  RewriteRule ^store/download/?$ store/download.html [L]
  RewriteRule ^checkout/?$ checkout/index.html [L]
  RewriteRule ^dashboard/?$ dashboard/index.html [L]
  RewriteRule ^admin/?$ admin/index.html [L]
  RewriteRule ^login/?$ login/index.html [L]
  RewriteRule ^review/?$ review/index.html [L]
</IfModule>
